# ==========================================
# ThePurple — Master Environment Blueprint
# ==========================================

# Server Configuration
NODE_ENV=development
PORT=5000
FRONTEND_URL=http://localhost:3000
IMAGE_TAG=latest
BACKEND_IMAGE=
FRONTEND_IMAGE=

# PostgreSQL Database Configuration
# The database admin is only used by PostgreSQL and the one-shot role bootstrap.
# Application and migration processes use separate, restricted credentials.
DB_HOST=localhost
DB_PORT=5432
DB_NAME=thepurple_db
DB_ADMIN_USER=thepurple_admin
DB_ADMIN_PASSWORD=REPLACE_WITH_UNIQUE_DATABASE_ADMIN_PASSWORD
DB_MIGRATION_USER=thepurple_migrator
DB_MIGRATION_PASSWORD=REPLACE_WITH_UNIQUE_MIGRATION_PASSWORD
DB_USER=thepurple_app
DB_PASSWORD=REPLACE_WITH_UNIQUE_APPLICATION_DATABASE_PASSWORD
DB_DIALECT=postgres
DB_LOGGING=false

# Redis Configuration
REDIS_URL=redis://localhost:6379
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD_FILE=./secrets/redis_password

# Meilisearch Configuration
MEILISEARCH_HOST=http://localhost:7700
MEILISEARCH_MASTER_KEY=REPLACE_WITH_RANDOM_KEY_AT_LEAST_32_CHARACTERS
MEILISEARCH_PORT=7700

# Production API/admin secrets
JWT_SECRET=REPLACE_WITH_RANDOM_SECRET_AT_LEAST_32_CHARACTERS
ADMIN_INITIAL_EMAIL=REPLACE_WITH_YOUR_ADMIN_EMAIL
ADMIN_INITIAL_PASSWORD=REPLACE_WITH_STRONG_PASSWORD_AT_LEAST_12_CHARACTERS

# SMTP is required in production for admin reset and invitation messages.
SMTP_HOST=REPLACE_WITH_SMTP_HOST
SMTP_PORT=587
SMTP_USER=REPLACE_WITH_SMTP_USERNAME
SMTP_PASSWORD=REPLACE_WITH_SMTP_PASSWORD
SMTP_FROM=ThePurple <no-reply@thepurple.in>

# Local frontend development; production builds require a public HTTPS API URL.
NEXT_PUBLIC_API_URL=http://localhost:5000/api/v1

# Cloudflare R2 (Product & Category Media)
CLOUDFLARE_R2_ACCOUNT_ID=
CLOUDFLARE_R2_ACCESS_KEY_ID=
CLOUDFLARE_R2_SECRET_ACCESS_KEY=
CLOUDFLARE_R2_BUCKET=thepurple-media
CLOUDFLARE_R2_PUBLIC_URL=https://media.thepurple.in

# Razorpay (Payment Gateway)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Shiprocket (Logistics & Shipment)
SHIPROCKET_API_KEY=
SHIPROCKET_API_SECRET=
SHIPROCKET_EMAIL=
SHIPROCKET_PASSWORD=
SHIPROCKET_WEBHOOK_SECRET=
SHIPROCKET_SYNC_CRON_MINUTES=15

# SMS / OTP Provider
SMS_OTP_API_KEY=
SMS_OTP_SENDER_ID=
