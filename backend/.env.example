# Server
NODE_ENV=development
PORT=5000
FRONTEND_URL=http://localhost:3000

# Database (PostgreSQL)
# Optional: set DATABASE_URL to use a remote PostgreSQL database.
# Local Docker:
#
# Supabase: do NOT use Direct (db.<ref>.supabase.co:5432) from a laptop — it is IPv6-only and very slow.
# Use Session pooler from Dashboard → Project Settings → Database → Connect:
#   postgresql://postgres.<PROJECT_REF>:<PASSWORD>@aws-0-<REGION>.pooler.supabase.com:5432/postgres
DB_HOST=localhost
DB_PORT=5432
DB_NAME=thepurple_db
DB_ADMIN_USER=thepurple_admin
DB_ADMIN_PASSWORD=REPLACE_WITH_UNIQUE_DATABASE_ADMIN_PASSWORD
DB_MIGRATION_USER=thepurple_migrator
DB_MIGRATION_PASSWORD=REPLACE_WITH_UNIQUE_MIGRATION_PASSWORD
DB_USER=thepurple_app
DB_PASSWORD=REPLACE_WITH_UNIQUE_APPLICATION_DATABASE_PASSWORD
DB_DIALECT=postgres
DB_LOGGING=false

# Redis
REDIS_URL=redis://localhost:6379
REDIS_HOST=localhost
REDIS_PORT=6379

# Meilisearch
MEILISEARCH_HOST=http://localhost:7700
MEILISEARCH_MASTER_KEY=REPLACE_WITH_RANDOM_KEY_AT_LEAST_32_CHARACTERS
MEILISEARCH_INDEX_PREFIX=thepurple

# Production API/admin secrets
JWT_SECRET=REPLACE_WITH_RANDOM_SECRET_AT_LEAST_32_CHARACTERS
ADMIN_INITIAL_EMAIL=REPLACE_WITH_YOUR_ADMIN_EMAIL
ADMIN_INITIAL_PASSWORD=REPLACE_WITH_STRONG_PASSWORD_AT_LEAST_12_CHARACTERS

# Required in production; never use real values in this template.
SMTP_HOST=REPLACE_WITH_SMTP_HOST
SMTP_PORT=587
SMTP_USER=REPLACE_WITH_SMTP_USERNAME
SMTP_PASSWORD=REPLACE_WITH_SMTP_PASSWORD
SMTP_FROM=ThePurple <no-reply@thepurple.in>

# Cloudflare R2
CLOUDFLARE_R2_ACCOUNT_ID=
CLOUDFLARE_R2_ACCESS_KEY_ID=
CLOUDFLARE_R2_SECRET_ACCESS_KEY=
CLOUDFLARE_R2_BUCKET=thepurple-media
CLOUDFLARE_R2_PUBLIC_URL=https://media.thepurple.in

# Razorpay
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Shiprocket
SHIPROCKET_EMAIL=
SHIPROCKET_PASSWORD=
SHIPROCKET_API_KEY=
SHIPROCKET_API_SECRET=
SHIPROCKET_WEBHOOK_SECRET=
SHIPROCKET_SYNC_CRON_MINUTES=15
